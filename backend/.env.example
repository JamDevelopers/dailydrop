# TextileDrop SaaS Environment Configuration

APP_NAME="TextileDrop API"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.yourdomain.com
CATALOG_PUBLIC_URL=https://catalog.yourdomain.com

# MySQL 8 Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=textiledrop_db
DB_USERNAME=textiledrop_user
DB_PASSWORD=YourSecurePasswordHere
DB_CHARSET=utf8mb4

# Storage & Upload Configuration
STORAGE_DISK=local
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_MIMES=image/jpeg,image/png,image/webp

# Security & CORS
CORS_ALLOWED_ORIGINS=https://app.yourdomain.com,https://catalog.yourdomain.com,http://localhost:3000

